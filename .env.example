# ---------------------------------------------------------------------------
# EngLoop — local environment
# Copy to .env (`cp .env.example .env`) and configure a real coding-agent CLI.
# Mock execution is opt-in and disabled by default.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true

# --- Database --------------------------------------------------------------
POSTGRES_USER=engloop
POSTGRES_PASSWORD=engloop
POSTGRES_DB=engloop
POSTGRES_PORT=5432
DATABASE_URL=postgresql://engloop:engloop@localhost:5432/engloop?schema=public

# --- Redis / queue ---------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=engloop

# --- API -------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
# Comma-separated. localhost and 127.0.0.1 are distinct browser origins — keep both.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SWAGGER_ENABLED=true

# --- Web -------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=EngLoop

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_HEALTH_PORT=4100

# --- Auth ------------------------------------------------------------------
# Local JWT login. Replace with an external IdP before internet-facing production.
AUTH_JWT_SECRET=change-me-in-production-please-32-chars-min
AUTH_JWT_EXPIRES_IN=7d
AUTH_DEV_BYPASS=false
AUTH_DEV_USER_EMAIL=founder@evalley.dev

# --- Browser E2E (pnpm test:e2e) -----------------------------------------
# The suite logs in through /api/auth/login with these credentials (defaults
# match `pnpm db:seed`). Point PLAYWRIGHT_CHROMIUM_PATH at an existing browser
# to skip `playwright install`.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# E2E_API_URL=http://localhost:4000/api
# E2E_USER_EMAIL=founder@evalley.dev
# E2E_USER_PASSWORD=engloop-dev-password
# PLAYWRIGHT_CHROMIUM_PATH=

# --- Secret encryption -----------------------------------------------------
# 32-byte key, base64. Generate: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=Y2hhbmdlLW1lLTMyLWJ5dGUta2V5LWZvci1kZXYtb25seQ==

# --- Agent providers -------------------------------------------------------
# codex | claude-code. Enable mock only for intentional offline tests.
AGENT_DEFAULT_PROVIDER=codex
AGENT_ENABLE_MOCK=false
AGENT_MOCK_LATENCY_MS=600
AGENT_MOCK_FAILURE_RATE=0
AGENT_MAX_REVIEW_CYCLES=3
AGENT_MAX_ATTEMPTS=3
# Defaults for an agent that sets no limits of its own. A run stops at whichever
# ceiling it reaches first, so keep these consistent: at current model pricing a
# $5 cap binds long before 200k tokens. Per-agent overrides live on the
# Configurations screen (Agents -> Configurations -> Edit limits).
AGENT_RUN_TIMEOUT_MS=900000
AGENT_TOKEN_BUDGET=200000
AGENT_COST_BUDGET_USD=5

# Real provider CLI configuration (non-secret wiring only).
# API keys are NOT set here. Configure them in the UI: Providers -> Set key.
# They are stored encrypted per organization with SECRETS_ENCRYPTION_KEY above.
# A provider with no stored key runs on the CLI's own login (codex login / claude).
CODEX_CLI_PATH=codex
CODEX_HOME=
CODEX_MODEL=gpt-6-astra
CLAUDE_CODE_CLI_PATH=claude
CLAUDE_CODE_MODEL=sonnet

# --- One-time real bootstrap ----------------------------------------------
# Set these, then run: pnpm bootstrap:real
ENGLOOP_BOOTSTRAP_ADMIN_EMAIL=
ENGLOOP_BOOTSTRAP_ADMIN_PASSWORD=
ENGLOOP_BOOTSTRAP_ORGANIZATION_NAME=
ENGLOOP_BOOTSTRAP_ORGANIZATION_SLUG=
ENGLOOP_BOOTSTRAP_PROVIDER_KEY=codex
ENGLOOP_BOOTSTRAP_PROVIDER_KIND=CODEX
ENGLOOP_BOOTSTRAP_PROVIDER_MODEL=gpt-6-astra

# --- Git / workspace -------------------------------------------------------
WORKSPACE_ROOT=./workspace
GIT_AUTHOR_NAME=EngLoop Agent
GIT_AUTHOR_EMAIL=agents@engloop.dev
GIT_DEFAULT_BASE_BRANCH=main
GIT_BRANCH_PREFIX=agent

# --- GitHub App -------------------------------------------------------------
# Leave every value empty to disable GitHub. If one is set, all are required.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_STATE_SECRET=
# Example: http://localhost:3000/projects/github/callback
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_API_BASE_URL=https://api.github.com

# --- Command runner --------------------------------------------------------
COMMAND_TIMEOUT_MS=600000
COMMAND_MAX_BUFFER_BYTES=10485760
# Only these executables may ever be spawned. Agent CLIs must be listed here too.
COMMAND_ALLOWLIST=pnpm,npm,node,npx,git,bash,sh,make,tsc,eslint,prettier,vitest,jest,playwright,claude,codex

# --- Playwright / UI QA ----------------------------------------------------
UI_QA_ENABLED=false
UI_QA_BASE_URL=http://localhost:3000
