{
  "name": "@engloop/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test factories, fixtures and vitest presets.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
