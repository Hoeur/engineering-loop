// EngLoop — multi-agent engineering orchestration platform.
//
// Enum members mirror `packages/types/src/enums.ts` exactly; `src/enum-parity.spec.ts`
// fails the build if the two ever drift.

generator client {
  provider = "prisma-client-js"
  // engineType = "client" turns off the Rust query engine entirely; the client
  // plans queries with the WebAssembly query compiler bundled in @prisma/client.
  engineType = "client"
  // Connections are opened by the `pg` driver adapter passed to `new PrismaClient`,
  // so no platform-specific engine binary is ever downloaded. See
  // docs/adr/0001-engine-free-prisma.md.
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

