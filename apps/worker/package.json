{
  "name": "@engloop/worker",
  "version": "0.1.0",
  "private": true,
  "description": "EngLoop execution worker: workflow engine, agents, checks, reviews.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node ../../scripts/clean.mjs ."
  },
  "dependencies": {
    "@engloop/agent-sdk": "workspace:*",
    "@engloop/config": "workspace:*",
    "@engloop/db": "workspace:*",
    "@engloop/git": "workspace:*",
    "@engloop/github": "workspace:*",
    "@engloop/logger": "workspace:*",
    "@engloop/schemas": "workspace:*",
    "@engloop/types": "workspace:*",
    "@engloop/workflow": "workspace:*",
    "bullmq": "5.58.5",
    "cron-parser": "4.9.0",
    "ioredis": "5.7.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
