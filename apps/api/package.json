{
  "name": "@engloop/api",
  "version": "0.1.0",
  "private": true,
  "description": "EngLoop control-plane REST API (NestJS).",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node ../../scripts/clean.mjs ."
  },
  "dependencies": {
    "@engloop/agent-sdk": "workspace:*",
    "@engloop/config": "workspace:*",
    "@engloop/db": "workspace:*",
    "@engloop/git": "workspace:*",
    "@engloop/github": "workspace:*",
    "@engloop/logger": "workspace:*",
    "@engloop/schemas": "workspace:*",
    "@engloop/types": "workspace:*",
    "@engloop/workflow": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "bullmq": "5.58.5",
    "cron-parser": "4.9.0",
    "ioredis": "5.7.0",
    "jose": "5.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.8",
    "@nestjs/testing": "11.1.6",
    "@swc/core": "1.13.5",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4"
  }
}
