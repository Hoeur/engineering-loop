{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Covers src + test for `typecheck`; tsconfig.build.json narrows rootDir to src.
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
