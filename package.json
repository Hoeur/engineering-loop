{
  "name": "engloop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** run build && pnpm -r --filter=./apps/** run build",
    "build:packages": "pnpm -r --filter=./packages/** run build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter=./apps/** run dev",
    "dev:api": "pnpm --filter @engloop/api dev",
    "dev:web": "pnpm --filter @engloop/web dev",
    "dev:worker": "pnpm --filter @engloop/worker dev",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r --parallel run test:watch",
    "test:e2e": "pnpm --filter @engloop/web run test:e2e",
    "db:generate": "pnpm --filter @engloop/db run generate",
    "db:migrate": "pnpm --filter @engloop/db run migrate",
    "db:deploy": "pnpm --filter @engloop/db run migrate:deploy",
    "db:baseline": "pnpm --filter @engloop/db run migrate:baseline",
    "db:status": "pnpm --filter @engloop/db run migrate:status",
    "db:seed": "pnpm --filter @engloop/db run seed",
    "bootstrap:real": "pnpm --filter @engloop/db run bootstrap:real",
    "db:reset": "pnpm --filter @engloop/db run reset",
    "db:studio": "pnpm --filter @engloop/db run studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v",
    "bootstrap": "node scripts/bootstrap.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "22.18.6",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1"
  }
}
